{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/bookmark/1.4.0/schema.json",
  "displayName": "Sector view: chart",
  "name": "bm_view_chart",
  "options": {
    "targetVisualNames": [
      "overview_secbar",
      "overview_sectab"
    ],
    "suppressData": true,
    "suppressActiveSection": true
  },
  "explorationState": {
    "version": "1.3",
    "activeSection": "overview",
    "sections": {
      "overview": {
        "visualContainers": {
          "overview_secbar": {
            "singleVisual": {
              "visualType": "clusteredBarChart",
              "objects": {}
            }
          },
          "overview_sectab": {
            "singleVisual": {
              "visualType": "tableEx",
              "objects": {},
              "display": {
                "mode": "hidden"
              }
            }
          }
        }
      }
    }
  }
}
