/// All report measures
table 'Key Measures'
	lineageTag: fea4a9cd-4fe8-5929-868a-137f7f459916

	/// Stated round amounts converted to EUR at the what-if FX rates; equity, venture debt and grants; exits excluded
	measure 'Capital Raised (EUR)' =
			VAR usd = [USD per EUR Value]
			VAR gbp = [GBP per EUR Value]
			RETURN
			    SUMX ( FILTER ( Rounds, Rounds[Counts As Capital] ), Rounds[Amount (Native)] / SWITCH ( Rounds[Currency], "EUR", 1, "USD", usd, "GBP", gbp ) )
		formatString: \€#,0
		displayFolder: Capital
		lineageTag: bf09b42c-5d4f-5661-b575-8f827f1d0e57

	/// Rounds with a stated amount, exits excluded
	measure 'Disclosed Rounds' = CALCULATE ( COUNTROWS ( Rounds ), Rounds[Counts As Capital] = TRUE () )
		formatString: #,0
		displayFolder: Capital
		lineageTag: 4d9aa381-20cb-5c0a-a307-72c74488fee9

	measure 'Average Round (EUR)' = DIVIDE ( [Capital Raised (EUR)], [Disclosed Rounds] )
		formatString: \€#,0
		displayFolder: Capital
		lineageTag: b4350fd8-33a1-55cc-9d4c-3b310e28972a

	measure 'Median Round (EUR)' =
			VAR usd = [USD per EUR Value]
			VAR gbp = [GBP per EUR Value]
			RETURN
			    MEDIANX ( FILTER ( Rounds, Rounds[Counts As Capital] ), Rounds[Amount (Native)] / SWITCH ( Rounds[Currency], "EUR", 1, "USD", usd, "GBP", gbp ) )
		formatString: \€#,0
		displayFolder: Capital
		lineageTag: 5cdd3535-1afb-5b58-8c28-8b46793985bd

	measure 'Largest Round (EUR)' =
			VAR usd = [USD per EUR Value]
			VAR gbp = [GBP per EUR Value]
			RETURN
			    MAXX ( FILTER ( Rounds, Rounds[Counts As Capital] ), Rounds[Amount (Native)] / SWITCH ( Rounds[Currency], "EUR", 1, "USD", usd, "GBP", gbp ) )
		formatString: \€#,0
		displayFolder: Capital
		lineageTag: 3c8f423c-5e80-5ad6-866b-4b6d21433a00

	/// Share of the capital in the current selection
	measure 'Capital Share %' = DIVIDE ( [Capital Raised (EUR)], CALCULATE ( [Capital Raised (EUR)], ALLSELECTED () ) )
		formatString: 0.0%
		displayFolder: Capital
		lineageTag: 9c898eac-82c4-5de0-8788-4989717f6300

	/// Disclosed rounds at or above the Min Round Size what-if value
	measure 'Rounds Above Threshold' =
			VAR usd = [USD per EUR Value]
			VAR gbp = [GBP per EUR Value]
			VAR minimum = [Min Round Size Value] * 1000000
			RETURN
			    COUNTROWS ( FILTER ( Rounds, Rounds[Counts As Capital] && Rounds[Amount (Native)] / SWITCH ( Rounds[Currency], "EUR", 1, "USD", usd, "GBP", gbp ) >= minimum ) ) + 0
		formatString: #,0
		displayFolder: Capital
		lineageTag: a1c5713c-bd3f-5763-b16f-85ef96a82268

	measure 'Capital Above Threshold (EUR)' =
			VAR usd = [USD per EUR Value]
			VAR gbp = [GBP per EUR Value]
			VAR minimum = [Min Round Size Value] * 1000000
			RETURN
			    SUMX ( FILTER ( Rounds, Rounds[Counts As Capital] && Rounds[Amount (Native)] / SWITCH ( Rounds[Currency], "EUR", 1, "USD", usd, "GBP", gbp ) >= minimum ), Rounds[Amount (Native)] / SWITCH ( Rounds[Currency], "EUR", 1, "USD", usd, "GBP", gbp ) )
		formatString: \€#,0
		displayFolder: Capital
		lineageTag: 7935b46d-c4b3-5579-950d-97297156531d

	/// Share of disclosed rounds whose amount is approximate or a lower bound
	measure 'Approximate Amount Share %' =
			DIVIDE (
			    CALCULATE ( [Disclosed Rounds], Rounds[Amount Flag] <> "As reported" ),
			    [Disclosed Rounds]
			)
		formatString: 0%
		displayFolder: Data quality
		lineageTag: 5bf740a5-896e-5888-bdd0-5c411589602c

	/// Every company's last-round row, disclosed or not
	measure 'Rounds (All)' = COUNTROWS ( Rounds )
		formatString: #,0
		displayFolder: Data quality
		lineageTag: ce8f5bc0-f611-5f54-8075-38c7c4e85e1a

	measure 'Undisclosed Rounds' = CALCULATE ( COUNTROWS ( Rounds ), Rounds[Amount Flag] = "Not disclosed" )
		formatString: #,0
		displayFolder: Data quality
		lineageTag: f94912d5-1d60-5e07-9600-f61c2f11e5cf

	measure Companies = COUNTROWS ( 'Company' )
		formatString: #,0
		displayFolder: Companies
		lineageTag: 8a772f89-8854-5825-b98e-1f8d4075e7f8

	measure 'Verified Companies' = CALCULATE ( [Companies], 'Company'[Verification Tier] = "Verified" )
		formatString: #,0
		displayFolder: Data quality
		lineageTag: aa5bec45-05d0-5d4f-bb97-fb9422dd51a1

	measure 'Verified Share %' = DIVIDE ( [Verified Companies], [Companies] )
		formatString: 0%
		displayFolder: Data quality
		lineageTag: 077b3e53-61e0-50c5-bad5-647f77b9c0af

	/// Companies with at least one Greek fund in the investors text
	measure 'Greek Fund Backed Companies' = CALCULATE ( DISTINCTCOUNT ( 'Company Fund'[Company ID] ) )
		formatString: #,0
		displayFolder: Funds
		lineageTag: 7c5b1a9b-610b-5378-8999-11188b38aaf8

	measure 'Greek Fund Backed Share %' = DIVIDE ( [Greek Fund Backed Companies], [Companies] )
		formatString: 0%
		displayFolder: Funds
		lineageTag: bf7823d7-b6c9-5470-96f2-7bfeb293d866

	/// Companies backed by Big Pi, Marathon, Metavallon, Velocity or egg
	measure 'Target Fund Portfolio' = CALCULATE ( DISTINCTCOUNT ( 'Company Fund'[Company ID] ), 'Fund'[Is Target Fund] = TRUE () )
		formatString: #,0
		displayFolder: Funds
		lineageTag: d333665f-e509-524c-9fb6-f258702846c2

	/// Fund-company pairs
	measure 'Fund Positions' = COUNTROWS ( 'Company Fund' )
		formatString: #,0
		displayFolder: Funds
		lineageTag: f8eda34e-6f6e-50e4-a15f-cc474c4019a9

	measure 'Lead Positions' = CALCULATE ( COUNTROWS ( 'Company Fund' ), 'Company Fund'[Role] = "Lead" )
		formatString: #,0
		displayFolder: Funds
		lineageTag: 9462f6ac-c6d6-55b1-97b6-acaf2d5b783f

	measure 'Lead Share %' = DIVIDE ( [Lead Positions], [Fund Positions] )
		formatString: 0%
		displayFolder: Funds
		lineageTag: cf6c5ee1-69e3-59c3-9de0-4d7610847fd4

	/// Companies backed by both the row fund (Fund) and the column fund (Co-Fund)
	measure 'Shared Portfolio Companies' =
			VAR rowFund = VALUES ( 'Company Fund'[Company ID] )
			VAR colFund =
			    CALCULATETABLE (
			        VALUES ( 'Company Fund'[Company ID] ),
			        REMOVEFILTERS ( 'Fund' ),
			        TREATAS ( VALUES ( 'Co-Fund'[Co-Fund] ), 'Fund'[Fund] )
			    )
			RETURN
			    COUNTROWS ( INTERSECT ( rowFund, colFund ) )
		formatString: #,0
		displayFolder: Funds
		lineageTag: 463a42cb-fa2d-53d2-8f7a-0ddbd07c7c31

	/// Shared Portfolio Companies with the diagonal (a fund with itself) left blank
	measure 'Co-Investments' =
			IF (
			    SELECTEDVALUE ( 'Fund'[Fund] ) <> SELECTEDVALUE ( 'Co-Fund'[Co-Fund] ),
			    [Shared Portfolio Companies]
			)
		formatString: #,0
		displayFolder: Funds
		lineageTag: 731a82e6-caf7-5786-81b7-8921dccf185e

	/// Jaccard overlap: shared companies / companies backed by either fund
	measure 'Portfolio Overlap %' =
			VAR rowFund = VALUES ( 'Company Fund'[Company ID] )
			VAR colFund =
			    CALCULATETABLE (
			        VALUES ( 'Company Fund'[Company ID] ),
			        REMOVEFILTERS ( 'Fund' ),
			        TREATAS ( VALUES ( 'Co-Fund'[Co-Fund] ), 'Fund'[Fund] )
			    )
			RETURN
			    DIVIDE ( COUNTROWS ( INTERSECT ( rowFund, colFund ) ), COUNTROWS ( DISTINCT ( UNION ( rowFund, colFund ) ) ) )
		formatString: 0%
		displayFolder: Funds
		lineageTag: 8dbe956a-e2df-510b-bbd1-fd05f9a40fe1

	measure 'Signal Events' = COUNTROWS ( Signals )
		formatString: #,0
		displayFolder: Signals
		lineageTag: 0fd3dd7a-0352-5f38-b17c-a50e843e4320

	measure 'News Items' = CALCULATE ( COUNTROWS ( Signals ), Signals[Signal Type] = "News" )
		formatString: #,0
		displayFolder: Signals
		lineageTag: a9769b96-ccc9-5d55-b85e-c8c3efb23616

	measure 'Job Postings' = CALCULATE ( COUNTROWS ( Signals ), Signals[Signal Type] = "Hiring" )
		formatString: #,0
		displayFolder: Signals
		lineageTag: d65e2dc2-47ab-5fec-81e9-9924a0726fe1

	measure 'Repos Pushed' = CALCULATE ( COUNTROWS ( Signals ), Signals[Signal Type] = "GitHub" )
		formatString: #,0
		displayFolder: Signals
		lineageTag: cf4b5eeb-9b71-5a8d-a69d-d50e35b7fb58

	measure 'EU Projects' = DISTINCTCOUNT ( Grants[Project ID] )
		formatString: #,0
		displayFolder: Grants
		lineageTag: 160254ab-0b4f-5aae-a0d2-52ff892b88f0

	/// EU contribution to the whole of each distinct project; a project linked to two companies counts once
	measure 'EU Grant Funding (EUR)' = SUMX ( VALUES ( Grants[Project ID] ), CALCULATE ( MAX ( Grants[EU Contribution (EUR)] ) ) )
		formatString: \€#,0
		displayFolder: Grants
		lineageTag: 3f055c66-bd61-5444-ba59-d918523a73d7

	/// The deal-flow tracker's own weekly score
	measure 'Tracker Week Score' = SUM ( Scores[Week Score] )
		formatString: #,0
		displayFolder: Signals
		lineageTag: 167a03ac-8d91-5742-a902-cf594c7759a6

	/// Snapshot date of the signals
	measure 'As-Of Date' = CALCULATE ( MAX ( Scores[Week Date] ), REMOVEFILTERS () )
		formatString: yyyy-mm-dd
		displayFolder: Momentum
		lineageTag: 807c0eee-570d-5d55-8105-5f9421a6c5d3

	/// News = 1 point, job posting = 2, GitHub push = 1
	measure 'Weighted Signals' =
			SUMX (
			    Signals,
			    SWITCH ( Signals[Signal Type], "News", 1, "Hiring", 2, "GitHub", 1, 0 )
			)
		formatString: #,0
		displayFolder: Momentum
		lineageTag: ca2c561f-6a46-5c31-a0d5-63b58ad6cb4b

	/// Weighted signals in the last N days (N = Momentum Window); an EU grant signed = 3
	measure 'Momentum Score' =
			VAR asOf = [As-Of Date]
			VAR w = [Momentum Window Value]
			VAR sig =
			    CALCULATE ( [Weighted Signals], REMOVEFILTERS ( 'Date' ), Signals[Event Date] > asOf - w, Signals[Event Date] <= asOf )
			VAR grants =
			    CALCULATE ( [EU Projects], REMOVEFILTERS ( 'Date' ), Grants[Signed Date] > asOf - w, Grants[Signed Date] <= asOf )
			RETURN
			    IF ( NOT ISEMPTY ( 'Company' ), sig + 3 * grants )
		formatString: #,0
		displayFolder: Momentum
		lineageTag: 0eabd03f-e5b1-5fac-9ebf-acedc3b58a99

	/// Same score for the N days before the current window
	measure 'Momentum Score (Prior Window)' =
			VAR asOf = [As-Of Date]
			VAR w = [Momentum Window Value]
			VAR sig =
			    CALCULATE ( [Weighted Signals], REMOVEFILTERS ( 'Date' ), Signals[Event Date] > asOf - 2 * w, Signals[Event Date] <= asOf - w )
			VAR grants =
			    CALCULATE ( [EU Projects], REMOVEFILTERS ( 'Date' ), Grants[Signed Date] > asOf - 2 * w, Grants[Signed Date] <= asOf - w )
			RETURN
			    IF ( NOT ISEMPTY ( 'Company' ), sig + 3 * grants )
		formatString: #,0
		displayFolder: Momentum
		lineageTag: edaf387a-a2f1-50b7-b340-f0219bc8203a

	measure 'Momentum Change' = IF ( NOT ISEMPTY ( 'Company' ), [Momentum Score] - [Momentum Score (Prior Window)] )
		formatString: +#,0;-#,0;0
		displayFolder: Momentum
		lineageTag: 864438f6-5b6f-5e4f-80b4-207b3ea48066

	measure 'Momentum Trend' =
			VAR cur = [Momentum Score]
			VAR prev = [Momentum Score (Prior Window)]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISEMPTY ( 'Company' ), BLANK (),
			        cur = 0 && prev = 0, "Quiet",
			        cur > prev, "Rising",
			        cur < prev, "Cooling",
			        "Steady"
			    )
		displayFolder: Momentum
		lineageTag: 9cfa365e-4d9c-5e1d-8df4-144b0d4aaefc

	measure 'Momentum Rank' =
			IF (
			    HASONEVALUE ( 'Company'[Company] ),
			    RANKX ( ALLSELECTED ( 'Company' ), [Momentum Score], , DESC, DENSE )
			)
		formatString: 0
		displayFolder: Momentum
		lineageTag: 20b6c6a9-48cd-54ee-a47a-27f7f0789448

	/// Companies with any signal in the momentum window
	measure 'Active Companies' = COUNTROWS ( FILTER ( VALUES ( 'Company'[Company ID] ), [Momentum Score] > 0 ) ) + 0
		formatString: #,0
		displayFolder: Momentum
		lineageTag: 0de4014e-ce06-5bb4-ac97-2d1de7507d78

	measure 'Backtest Rose' = CALCULATE ( COUNTROWS ( Backtest ), Backtest[Change] = "rose" )
		formatString: #,0
		displayFolder: Momentum
		lineageTag: 50ef1f56-9336-52da-88d3-031675de8b29

	measure 'Backtest Companies' = COUNTROWS ( Backtest )
		formatString: #,0
		displayFolder: Momentum
		lineageTag: 02960e67-f088-5d2a-9a94-f3baad985815

	measure 'Selected Company' = SELECTEDVALUE ( 'Company'[Company], "Select a company" )
		displayFolder: Labels
		lineageTag: b4d4a4ee-765b-5044-be0f-2d928424424a

	measure 'Last Round Text' = SELECTEDVALUE ( Rounds[Amount Text] )
		displayFolder: Labels
		lineageTag: bb10ca57-17c8-5a71-af27-34a365bcc109

	measure 'Last Round Date Text' = SELECTEDVALUE ( Rounds[Date Text] )
		displayFolder: Labels
		lineageTag: 1e69be81-f3c2-5d4c-beb9-b5ba0cfff13c

	measure 'Company Funds Text' =
			VAR f = SELECTEDVALUE ( 'Company'[Greek Funds] )
			RETURN IF ( HASONEVALUE ( 'Company'[Company ID] ), IF ( f = "", "No Greek fund named in the investors text", f ) )
		displayFolder: Labels
		lineageTag: b4feef8e-ff88-5573-8da6-6d833a6f5d4e

	measure 'Fund Lens Title' = "Fund lens: " & IF ( HASONEVALUE ( 'Fund'[Fund] ), VALUES ( 'Fund'[Fund] ), "all Greek funds" )
		displayFolder: Labels
		lineageTag: 052fadfc-32da-5010-9611-fe247a006603

	measure 'FX Note' =
			"Amounts in EUR at " & FORMAT ( [USD per EUR Value], "0.0000" ) & " USD and "
			    & FORMAT ( [GBP per EUR Value], "0.00000" ) & " GBP per EUR (ECB reference rates of 2026-11-12 unless changed)" 
		displayFolder: Labels
		lineageTag: b92f0d08-50ad-5c61-aa97-b685fdd25b03

	measure 'As-Of Label' = "Signals as of " & FORMAT ( [As-Of Date], "d mmm yyyy" ) & ", window " & [Momentum Window Value] & " days"
		displayFolder: Labels
		lineageTag: 822e525a-e93d-5e1a-a7ac-4b55579cbc7c

	measure 'Company Header' = SELECTEDVALUE ( 'Company'[Company] ) & "  |  " & SELECTEDVALUE ( 'Company'[Sector] ) & "  |  " & SELECTEDVALUE ( 'Company'[Stage (Reported)] )
		displayFolder: Labels
		lineageTag: 7090c117-5db5-5ed7-ae5a-51089a40ab40

	/// Area sparkline of capital raised by round year, 2019-2026
	measure 'Capital Sparkline SVG' =
			VAR yrs = GENERATESERIES ( 2019, 2026, 1 )
			VAR t =
			    ADDCOLUMNS (
			        yrs,
			        "@v", VAR y = [Value] RETURN CALCULATE ( [Capital Raised (EUR)], 'Date'[Year] = y ) + 0
			    )
			VAR mx = MAXX ( t, [@v] )
			VAR pts =
			    CONCATENATEX (
			        t,
			        FORMAT ( ( [Value] - 2019 ) * 100 / 7, "0.0", "en-US" ) & ","
			            & FORMAT ( 36 - DIVIDE ( [@v], mx ) * 32, "0.0", "en-US" ),
			        " ", [Value], ASC
			    )
			VAR lastY = 36 - DIVIDE ( MAXX ( FILTER ( t, [Value] = 2026 ), [@v] ), mx ) * 32
			RETURN
			    IF (
			        mx > 0,
			        "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='-4 -4 108 46'>"
			            & "<polygon points='0,38 " & pts & " 100,38' fill='%23B7DDE0' fill-opacity='0.7'/>"
			            & "<polyline points='" & pts & "' fill='none' stroke='%230E7C86' stroke-width='2.5' stroke-linejoin='round' stroke-linecap='round'/>"
			            & "<circle cx='100' cy='" & FORMAT ( lastY, "0.0", "en-US" ) & "' r='3.5' fill='%230E7C86'/></svg>"
			    )
		displayFolder: Design\SVG
		dataCategory: ImageUrl
		lineageTag: 98e9d3ec-4e6c-56ee-98d1-b71e7c0f6bc8

	/// Area sparkline of signal events per month, last 12 months to the snapshot
	measure 'Signals Sparkline SVG' =
			VAR asOf = [As-Of Date]
			VAR startM = DATE ( YEAR ( asOf ), MONTH ( asOf ) - 11, 1 )
			VAR t =
			    ADDCOLUMNS (
			        GENERATESERIES ( 0, 11, 1 ),
			        "@v",
			            VAR s = EDATE ( startM, [Value] )
			            VAR e = EOMONTH ( s, 0 )
			            RETURN
			                CALCULATE ( COUNTROWS ( Signals ), REMOVEFILTERS ( 'Date' ), Signals[Event Date] >= s, Signals[Event Date] <= e ) + 0
			    )
			VAR mx = MAXX ( t, [@v] )
			VAR pts =
			    CONCATENATEX (
			        t,
			        FORMAT ( [Value] * 100 / 11, "0.0", "en-US" ) & ","
			            & FORMAT ( 36 - DIVIDE ( [@v], mx ) * 32, "0.0", "en-US" ),
			        " ", [Value], ASC
			    )
			VAR lastY = 36 - DIVIDE ( MAXX ( FILTER ( t, [Value] = 11 ), [@v] ), mx ) * 32
			RETURN
			    IF (
			        mx > 0,
			        "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='-4 -4 108 46'>"
			            & "<polygon points='0,38 " & pts & " 100,38' fill='%23B7DDE0' fill-opacity='0.7'/>"
			            & "<polyline points='" & pts & "' fill='none' stroke='%230E7C86' stroke-width='2.5' stroke-linejoin='round' stroke-linecap='round'/>"
			            & "<circle cx='100' cy='" & FORMAT ( lastY, "0.0", "en-US" ) & "' r='3.5' fill='%230E7C86'/></svg>"
			    )
		displayFolder: Design\SVG
		dataCategory: ImageUrl
		lineageTag: d97afb7a-d391-5234-b82f-d468c290de85

	/// Progress ring: share of companies backed by a Greek fund
	measure 'Backed Share Ring SVG' =
			VAR p = [Greek Fund Backed Share %]
			RETURN
			    IF (
			        NOT ISBLANK ( p ),
			        "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 42 42'>"
			            & "<circle cx='21' cy='21' r='15.9155' fill='none' stroke='%23E2E8F0' stroke-width='5'/>"
			            & "<circle cx='21' cy='21' r='15.9155' fill='none' stroke='%230E7C86' stroke-width='5' stroke-linecap='round' stroke-dashoffset='25' stroke-dasharray='"
			            & FORMAT ( p * 100, "0.0", "en-US" ) & " " & FORMAT ( 100 - p * 100, "0.0", "en-US" ) & "'/>"
			            & "<text x='21' y='24.6' text-anchor='middle' font-family='Segoe UI' font-weight='600' font-size='10' fill='%230F1B2D'>"
			            & SUBSTITUTE ( FORMAT ( p, "0%" ), "%", "%25" ) & "</text></svg>"
			    )
		displayFolder: Design\SVG
		dataCategory: ImageUrl
		lineageTag: 2aca7090-7487-5d53-866a-1c3ddbef2e35

	/// Progress ring: share of fund positions held as lead
	measure 'Lead Share Ring SVG' =
			VAR p = [Lead Share %]
			RETURN
			    IF (
			        NOT ISBLANK ( p ),
			        "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 42 42'>"
			            & "<circle cx='21' cy='21' r='15.9155' fill='none' stroke='%23E2E8F0' stroke-width='5'/>"
			            & "<circle cx='21' cy='21' r='15.9155' fill='none' stroke='%230E7C86' stroke-width='5' stroke-linecap='round' stroke-dashoffset='25' stroke-dasharray='"
			            & FORMAT ( p * 100, "0.0", "en-US" ) & " " & FORMAT ( 100 - p * 100, "0.0", "en-US" ) & "'/>"
			            & "<text x='21' y='24.6' text-anchor='middle' font-family='Segoe UI' font-weight='600' font-size='10' fill='%230F1B2D'>"
			            & SUBSTITUTE ( FORMAT ( p, "0%" ), "%", "%25" ) & "</text></svg>"
			    )
		displayFolder: Design\SVG
		dataCategory: ImageUrl
		lineageTag: 35fea577-b4b6-5982-bf0c-c2154cf86df5

	/// Bullet chart: bar = share of capital, tick = share of companies (scale 0-50%); teal when capital share is the larger
	measure 'Sector Bullet SVG' =
			VAR cs = [Capital Share %] + 0
			VAR ks = DIVIDE ( [Companies], CALCULATE ( [Companies], ALLSELECTED ( 'Sector' ) ) )
			VAR scale = 0.5
			VAR wBar = MIN ( cs / scale, 1 ) * 100
			VAR xK = MIN ( ks / scale, 1 ) * 100
			VAR barColor = IF ( cs > ks, "%230E7C86", "%2394A3B8" )
			RETURN
			    IF (
			        NOT ISBLANK ( ks ),
			        "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 20' preserveAspectRatio='none'>"
			            & "<rect x='0' y='6' width='100' height='8' rx='4' fill='%23E2E8F0'/>"
			            & "<rect x='0' y='6' width='" & FORMAT ( wBar, "0.0", "en-US" ) & "' height='8' rx='4' fill='" & barColor & "'/>"
			            & "<rect x='" & FORMAT ( MAX ( xK - 1, 0 ), "0.0", "en-US" ) & "' y='1' width='2' height='18' fill='%230F1B2D'/></svg>"
			    )
		displayFolder: Design\SVG
		dataCategory: ImageUrl
		lineageTag: 94f83944-39d5-587e-af25-e222de14c245

	/// Accent for the tp sector, neutral for the rest
	measure 'Sector Bar Color' =
			VAR tp = MAXX ( ALLSELECTED ( 'Sector'[Sector Short] ), [Capital Raised (EUR)] )
			RETURN IF ( [Capital Raised (EUR)] = tp, "#0E7C86", "#B8C4CF" )
		displayFolder: Design\Colour
		lineageTag: f37e23ad-9def-543c-9c1b-8f7b2f5af9d3

	/// Accent for venture stages, ink for exits, neutral for the rest
	measure 'Stage Color' = SWITCH ( SELECTEDVALUE ( 'Stage'[Stage Family] ), "Venture", "#0E7C86", "Exit", "#0F1B2D", "#B8C4CF" )
		displayFolder: Design\Colour
		lineageTag: 340ded46-1f16-5ecc-a041-24541166e120

	/// Accent for the five target funds
	measure 'Fund Bar Color' = IF ( SELECTEDVALUE ( 'Fund'[Is Target Fund] ), "#0E7C86", "#B8C4CF" )
		displayFolder: Design\Colour
		lineageTag: 7b181916-e11b-554e-b796-4a02077ba9fe

	measure 'Momentum Change Color' =
			VAR c = [Momentum Change]
			RETURN IF ( c > 0, "#0E7C86", IF ( c < 0, "#C2410C", "#64748B" ) )
		displayFolder: Design\Colour
		lineageTag: efaa2f43-d74a-5504-91bd-239f215bfdbd

	measure 'Trend Color' = SWITCH ( [Momentum Trend], "Rising", "#0E7C86", "Cooling", "#C2410C", "#94A3B8" )
		displayFolder: Design\Colour
		lineageTag: 0827a1df-d817-5061-8656-4c4a434d8617

	/// Trend with an arrow icon
	measure 'Trend Label' = SWITCH ( [Momentum Trend], "Rising", "▲ Rising", "Cooling", "▼ Cooling", "Steady", "► Steady", "Quiet", "• Quiet" )
		displayFolder: Design\Colour
		lineageTag: 465054c5-30d3-51dd-9be4-3a1ef4391fea

	/// Companies whose momentum score rose against the prior window
	measure 'Rising Companies' = COUNTROWS ( FILTER ( VALUES ( 'Company'[Company ID] ), [Momentum Change] > 0 ) ) + 0
		formatString: #,0
		displayFolder: Momentum
		lineageTag: 8ee5db13-e59e-5cc1-bda8-67271c7ab4df

	/// Companies in view backed by two or more Greek funds
	measure 'Co-invested Companies' =
			COUNTROWS (
			    FILTER (
			        VALUES ( 'Company Fund'[Company ID] ),
			        CALCULATE ( DISTINCTCOUNT ( 'Company Fund'[Fund] ), REMOVEFILTERS ( 'Fund' ) ) >= 2
			    )
			) + 0
		formatString: #,0
		displayFolder: Funds
		lineageTag: 993fa013-cdab-578c-8578-8f8714027555

	measure 'KPI Companies Context' = FORMAT ( [Verified Share %], "0%" ) & " fully verified"
		displayFolder: Design\KPI
		lineageTag: 075f3764-8405-54c4-9cd0-7440dd083b46

	measure 'KPI Capital Context' = "Median round €" & FORMAT ( [Median Round (EUR)] / 1000000, "0.0", "en-US" ) & "M"
		displayFolder: Design\KPI
		lineageTag: 101db8da-d729-5922-a036-662117d64a50

	measure 'KPI Rounds Context' = FORMAT ( [Undisclosed Rounds] + 0, "0" ) & " more undisclosed"
		displayFolder: Design\KPI
		lineageTag: 06fd570b-6d0e-5cc6-9989-77ecaac67435

	measure 'KPI Backed Context' = FORMAT ( [Target Fund Portfolio], "0" ) & " with a target fund"
		displayFolder: Design\KPI
		lineageTag: 20c388e2-fa9b-56b1-bcc9-8b022e7e5fa1

	measure 'KPI Momentum Context' =
			VAR c = [Momentum Change]
			RETURN IF ( c >= 0, "▲ +", "▼ -" ) & FORMAT ( ABS ( c ), "#,0" ) & " vs prior " & [Momentum Window Value] & "d" 
		displayFolder: Design\KPI
		lineageTag: b5b68dea-ef2f-5050-8504-c4be276f1c96

	measure 'KPI Grants Context' = FORMAT ( [EU Projects] + 0, "#,0" ) & " CORDIS projects"
		displayFolder: Design\KPI
		lineageTag: faf7931c-b5bb-5469-aefe-c79a686efc05

	measure 'KPI Active Context' = "of " & FORMAT ( [Companies], "0" ) & " companies in view"
		displayFolder: Design\KPI
		lineageTag: 874831ee-aadd-593b-8de4-64ef9fe130b1

	measure 'KPI Rising Context' = "up vs the prior " & [Momentum Window Value] & " days"
		displayFolder: Design\KPI
		lineageTag: 8d9c8dc4-21b6-59bc-a4f7-412a9352c289

	measure 'KPI Portfolio Context' = FORMAT ( DIVIDE ( [Greek Fund Backed Companies], CALCULATE ( [Companies], REMOVEFILTERS ( 'Fund' ) ) ), "0%" ) & " of companies in view" 
		displayFolder: Design\KPI
		lineageTag: 3da04f5f-c1e5-5912-954e-7ba3531d6d59

	measure 'KPI Lead Context' = FORMAT ( [Lead Positions] + 0, "0" ) & " of " & FORMAT ( [Fund Positions] + 0, "0" ) & " positions as lead"
		displayFolder: Design\KPI
		lineageTag: 2f752887-df90-5217-a18b-3c4cf09ef5c8

	/// Capital raised in EUR millions, as text for KPI tiles
	measure 'KPI Capital Value' = IF ( NOT ISBLANK ( [Capital Raised (EUR)] ), "€" & FORMAT ( [Capital Raised (EUR)] / 1000000, "#,0", "en-US" ) & "M" )
		displayFolder: Design\KPI
		lineageTag: 0a513c0d-aa44-5359-a0fa-95df788605a5

	/// EU grant funding in EUR millions, as text for KPI tiles
	measure 'KPI Grants Value' = IF ( NOT ISBLANK ( [EU Grant Funding (EUR)] ), "€" & FORMAT ( [EU Grant Funding (EUR)] / 1000000, "#,0", "en-US" ) & "M" )
		displayFolder: Design\KPI
		lineageTag: 67489491-6df0-51a2-9ed6-3c2821605ea2

	measure 'KPI Change Context' = "score points vs the prior " & [Momentum Window Value] & "d"
		displayFolder: Design\KPI
		lineageTag: ae978580-720a-5ff0-a933-15697c56cd3e

	measure 'Profile What They Do' = SELECTEDVALUE ( 'Company'[What They Do] )
		displayFolder: Design\Profile
		lineageTag: 9937ad45-92d0-5d7f-8cd4-f2f65f2595f7

	measure 'Profile HQ' = SELECTEDVALUE ( 'Company'[HQ / Greek Link] )
		displayFolder: Design\Profile
		lineageTag: d6d74f69-40ee-58eb-955d-8e546b93522a

	measure 'Profile Verification' = SELECTEDVALUE ( 'Company'[Verification Tier] ) & ": " & SELECTEDVALUE ( 'Company'[Verification Status] )
		displayFolder: Design\Profile
		lineageTag: 6bdc710a-623a-51e7-9505-d1b169ffb3a9

	measure 'Profile Deal' = SELECTEDVALUE ( Rounds[Deal Type] ) & ", amount " & LOWER ( SELECTEDVALUE ( Rounds[Amount Flag] ) )
		displayFolder: Design\Profile
		lineageTag: b5c0f418-8d9f-50d4-ae39-8914fc299260

	measure 'Profile Investors' = SELECTEDVALUE ( Rounds[Investors] )
		displayFolder: Design\Profile
		lineageTag: 9497d9ed-0666-5e8e-830e-0ff4848e7dfe

	measure 'KPI Threshold Context' = "€" & FORMAT ( [Capital Above Threshold (EUR)] / 1000000, "#,0", "en-US" ) & "M in those rounds"
		displayFolder: Design\KPI
		lineageTag: c42e675b-7fa0-565f-bd6e-4d997218bfff

	measure 'KPI Co-invested Context' = "backed by two or more Greek funds"
		displayFolder: Design\KPI
		lineageTag: 255e57bc-9e27-5d3c-bc0a-2daeb974257e

	/// Header subtitle that reacts to the sector and fund slicers
	measure 'Selection Summary' =
			VAR s =
			    IF (
			        ISFILTERED ( 'Sector'[Sector] ) || ISFILTERED ( 'Sector'[Sector Short] ),
			        CONCATENATEX ( VALUES ( 'Sector'[Sector Short] ), 'Sector'[Sector Short], ", " ),
			        "all sectors"
			    )
			VAR f =
			    IF (
			        ISFILTERED ( 'Fund'[Fund] ) || ISFILTERED ( 'Fund'[Fund Short] ),
			        CONCATENATEX ( VALUES ( 'Fund'[Fund Short] ), 'Fund'[Fund Short], ", " ),
			        "all Greek funds"
			    )
			RETURN
			    FORMAT ( [Companies] + 0, "0" ) & " companies  ·  " & s & "  ·  " & f & "  ·  snapshot 26 Oct 2026" 
		displayFolder: Design\Titles
		lineageTag: 197c2a71-dc11-5b4f-9c24-5b2fa838530f

	measure 'Title Capital by Year' =
			VAR t = ADDCOLUMNS ( VALUES ( 'Date'[Year] ), "@c", [Capital Raised (EUR)] )
			VAR tp = TOPN ( 1, t, [@c], DESC, 'Date'[Year], DESC )
			VAR y = MAXX ( tp, 'Date'[Year] )
			VAR sh = DIVIDE ( MAXX ( tp, [@c] ), SUMX ( t, [@c] ) )
			RETURN IF ( NOT ISBLANK ( sh ), y & " holds " & FORMAT ( sh, "0%" ) & " of dated last-round capital", "No dated rounds in this view" )
		displayFolder: Design\Titles
		lineageTag: bd4da807-364b-5305-9d37-ad794c72accc

	measure 'Title Capital by Sector' =
			VAR t = ADDCOLUMNS ( VALUES ( 'Sector'[Sector Short] ), "@c", [Capital Raised (EUR)] )
			VAR tp = TOPN ( 1, t, [@c], DESC, 'Sector'[Sector Short], ASC )
			VAR sh = DIVIDE ( MAXX ( tp, [@c] ), SUMX ( t, [@c] ) )
			RETURN IF ( NOT ISBLANK ( sh ), MAXX ( tp, 'Sector'[Sector Short] ) & " takes " & FORMAT ( sh, "0%" ) & " of disclosed capital", "No disclosed capital in this view" )
		displayFolder: Design\Titles
		lineageTag: 322ffbac-a9b4-5f45-b076-dbfd556738cd

	measure 'Title Stage' =
			VAR t = ADDCOLUMNS ( VALUES ( 'Stage'[Stage Group] ), "@n", [Companies] )
			VAR tp = TOPN ( 1, t, [@n], DESC, 'Stage'[Stage Group], ASC )
			RETURN MAXX ( tp, 'Stage'[Stage Group] ) & " is the most common stage (" & MAXX ( tp, [@n] ) & ")" 
		displayFolder: Design\Titles
		lineageTag: 93033c18-6930-5293-9819-f92f570496dc

	measure 'Title Momentum' =
			VAR t = ADDCOLUMNS ( VALUES ( 'Company'[Company] ), "@m", [Momentum Score] )
			VAR tp = TOPN ( 1, t, [@m], DESC, 'Company'[Company], ASC )
			RETURN MAXX ( tp, 'Company'[Company] ) & " leads on momentum (score " & FORMAT ( MAXX ( tp, [@m] ), "0" ) & ")" 
		displayFolder: Design\Titles
		lineageTag: f90f95f7-0e6d-5706-b072-99cb00cabf8c

	measure 'Title Fund Positions' =
			VAR t = ADDCOLUMNS ( VALUES ( 'Fund'[Fund Short] ), "@n", [Greek Fund Backed Companies] )
			VAR tp = TOPN ( 1, t, [@n], DESC, 'Fund'[Fund Short], ASC )
			RETURN MAXX ( tp, 'Fund'[Fund Short] ) & " holds the most positions (" & MAXX ( tp, [@n] ) & ")" 
		displayFolder: Design\Titles
		lineageTag: 26c21138-d10f-502c-80d5-1fc2ebf000f2

	measure 'Title Overlap' =
			VAR t =
			    ADDCOLUMNS (
			        CROSSJOIN ( VALUES ( 'Fund'[Fund Short] ), VALUES ( 'Co-Fund'[Co-Fund Short] ) ),
			        "@s", [Co-Investments]
			    )
			VAR tp = TOPN ( 1, t, [@s], DESC, 'Fund'[Fund Short], ASC, 'Co-Fund'[Co-Fund Short], ASC )
			VAR n = MAXX ( tp, [@s] )
			RETURN
			    IF (
			        n > 0,
			        MAXX ( tp, 'Fund'[Fund Short] ) & " and " & MAXX ( tp, 'Co-Fund'[Co-Fund Short] ) & " share the most companies (" & n & ")",
			        "No two Greek funds share a company in this view"
			    )
		displayFolder: Design\Titles
		lineageTag: 703fbc45-0e41-543a-9891-fc009b9f0960

	column 'Measure Placeholder'
		dataType: string
		isHidden
		lineageTag: 6be5aa8c-173d-5153-a692-45023d44d94c
		summarizeBy: none
		sourceColumn: Measure Placeholder

		annotation SummarizationSetBy = Automatic

	partition 'Key Measures' = m
		mode: import
		source =
				#table(type table [#"Measure Placeholder" = text], {})

	annotation PBI_ResultType = Table
