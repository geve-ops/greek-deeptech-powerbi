		lineageTag: 57545028-b5fd-57ff-bf9c-45b3ee40f4ae
		summarizeBy: none
		sourceColumn: Stage Family

		annotation SummarizationSetBy = Automatic

	partition Stage = m
		mode: import
		source =
				#table(type table [#"Stage Group" = text, #"Stage Order" = Int64.Type, #"Stage Family" = text], {
				    {"Pre-seed", 1, "Venture"}, {"Seed", 2, "Venture"}, {"Series A", 3, "Venture"}, {"Series B+ / Growth", 4, "Venture"},
				    {"Exited", 5, "Exit"}, {"Grant / Incubated", 6, "Non-venture"}, {"Strategic / Corporate / SME", 7, "Non-venture"},
				    {"Debt / Other", 8, "Non-venture"}, {"Unverified", 9, "Unknown"}})

	annotation PBI_ResultType = Table
