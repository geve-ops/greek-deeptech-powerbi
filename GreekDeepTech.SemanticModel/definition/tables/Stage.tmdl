/// Stage buckets for the free-text stage labels
table Stage
	lineageTag: ca8b2ab1-d849-51c5-8adc-3ae43c5fad62

	column 'Stage Group'
		dataType: string
		lineageTag: 1d3d70da-6171-5f22-a0e1-918bccea5a95
		summarizeBy: none
		sourceColumn: Stage Group
		sortByColumn: 'Stage Order'

		annotation SummarizationSetBy = Automatic

	column 'Stage Order'
		dataType: int64
		formatString: 0
		isHidden
		lineageTag: ff90c827-2e34-5f23-bfdb-1b326da91870
		summarizeBy: none
		sourceColumn: Stage Order

		annotation SummarizationSetBy = Automatic

	column 'Stage Family'
