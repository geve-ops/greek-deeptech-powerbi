		sourceColumn: URL
		dataCategory: WebUrl

		annotation SummarizationSetBy = Automatic

	partition Grants = m
		mode: import
		source =
				let
				    Cos = Table.ToRecords(Snapshot),
				    toDate = (x) => if x = null or x = "" then null else Date.FromText(Text.Start(x, 10), [Format = "yyyy-MM-dd", Culture = "en-US"]),
				    Recs = List.Combine(List.Transform(Cos, (c) =>
				        let g = if c[Value] = null then null else Record.FieldOrDefault(c[Value], "grants", null),
				            l = if g = null then {} else Record.FieldOrDefault(g, "items", {})
				        in List.Transform(l, (i) => [
				            #"Company ID" = c[Name], #"Project ID" = Text.From(i[id]), Acronym = Record.FieldOrDefault(i, "acronym", null),
				            Title = i[title], #"Signed Date" = toDate(Record.FieldOrDefault(i, "signed", null)),
				            #"Start Date" = toDate(Record.FieldOrDefault(i, "start", null)), #"End Date" = toDate(Record.FieldOrDefault(i, "end", null)),
				            #"EU Contribution (EUR)" = Record.FieldOrDefault(i, "eu_contribution", null),
				            Status = Record.FieldOrDefault(i, "status", null), URL = i[url]]))),
				    Out = Table.FromRecords(Recs, type table [#"Company ID" = text, #"Project ID" = text, Acronym = text, Title = text,
				        #"Signed Date" = date, #"Start Date" = date, #"End Date" = date, #"EU Contribution (EUR)" = number, Status = text, URL = text])
				in
				    Out

	annotation PBI_ResultType = Table
