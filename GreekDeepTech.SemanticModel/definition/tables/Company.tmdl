	/// Greek funds named in the company's investors text, pipe-separated
	column 'Greek Funds'
		dataType: string
		lineageTag: 724947c5-f8fc-596a-8ae6-10d84cd90fd5
		summarizeBy: none
		sourceColumn: Greek Funds

		annotation SummarizationSetBy = Automatic

	column 'Pipeline Stage'
		dataType: string
		lineageTag: 0c83cde6-26b6-542c-87b0-b82ecf2d6eba
		summarizeBy: none
		sourceColumn: Pipeline Stage

		annotation SummarizationSetBy = Automatic

	column Recommendation
		dataType: string
		lineageTag: c848d080-f877-59be-9d38-7cd54fd20000
		summarizeBy: none
		sourceColumn: Recommendation

		annotation SummarizationSetBy = Automatic

	column 'Next Action'
		dataType: string
		lineageTag: b77c33cc-a2ad-50e3-97cb-1834f97bd2cb
		summarizeBy: none
		sourceColumn: Next Action

		annotation SummarizationSetBy = Automatic

	partition Company = m
		mode: import
		source =
				let
				    Raw = RawCompanies,
				    Funds = #"Company Fund",
				    FundList = Table.Group(Funds, {"Company ID"}, {{"Greek Funds", each Text.Combine(List.Sort([Fund]), " | "), type text}}),
				    Watch = Table.PromoteHeaders(Csv.Document(File.Contents(DataFolder & "watchlist.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv])),
				    WatchIds = List.Buffer(Table.Column(Watch, Table.ColumnNames(Watch){0})),
				    Pipe = Table.PromoteHeaders(Csv.Document(File.Contents(DataFolder & "pipeline.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv])),
				    PipeT = Table.RenameColumns(Table.SelectColumns(Pipe, {Table.ColumnNames(Pipe){0}, "pipeline_stage", "recommendation", "next_action"}),
				        {{Table.ColumnNames(Pipe){0}, "pid"}, {"pipeline_stage", "Pipeline Stage"}, {"recommendation", "Recommendation"}, {"next_action", "Next Action"}}),
				    Base = Table.SelectColumns(Raw, {"company_id", "company", "category", "sub_sector", "what_they_do", "founded", "hq_greek_link",
				        "stage", "map_status", "verification_status", "website", "source_link", "notes", "last_verified", "github_org", "linkedin_url"}),
				    Renamed = Table.RenameColumns(Base, {
				        {"company_id", "Company ID"}, {"company", "Company"}, {"category", "Sector"}, {"sub_sector", "Sub-sector"},
				        {"what_they_do", "What They Do"}, {"founded", "Founded (Reported)"}, {"hq_greek_link", "HQ / Greek Link"},
				        {"stage", "Stage (Reported)"}, {"map_status", "Map Status"}, {"verification_status", "Verification Status"},
				        {"website", "Website"}, {"source_link", "Source Links"}, {"notes", "Notes"}, {"last_verified", "Last Verified"},
				        {"github_org", "GitHub Org"}, {"linkedin_url", "LinkedIn"}}),
				    AddStage = Table.AddColumn(Renamed, "Stage Group", each fnStageGroup([#"Stage (Reported)"]), type text),
				    AddFounded = Table.AddColumn(AddStage, "Founded Year", each
				        let s = Text.Start([#"Founded (Reported)"], 4) in
				        if Text.Length(s) = 4 and List.AllTrue(List.Transform(Text.ToList(s), (c) => List.Contains({"0".."9"}, c))) then Number.FromText(s) else null, Int64.Type),
				    AddTier = Table.AddColumn(AddFounded, "Verification Tier", each
				        let v = Text.Lower([Verification Status]) in
				        if List.AnyTrue(List.Transform({"unverified", "not found", "conflict", "single", "not re-verified", "only", "vary", "differ", "thin", "partly", "stale", "not confirmed"}, (w) => Text.Contains(v, w)))
				            then (if Text.Contains(v, "verified") and not Text.StartsWith(v, "not ") then "Verified with caveats" else "Not verified")
				        else if Text.Contains(v, "verified") then "Verified" else "Not verified", type text),
				    AddScope = Table.AddColumn(AddTier, "In Scope", each List.Contains({"Include", "Borderline"}, [Map Status]), type logical),
				    AddSource = Table.AddColumn(AddScope, "Primary Source", each Text.Trim(Text.BeforeDelimiter([Source Links], "|")), type text),
				    AddWatch = Table.AddColumn(AddSource, "On Watchlist", each List.Contains(WatchIds, [Company ID]), type logical),
				    JoinFunds = Table.NestedJoin(AddWatch, {"Company ID"}, FundList, {"Company ID"}, "F", JoinKind.LeftOuter),
				    ExpFunds = Table.ExpandTableColumn(JoinFunds, "F", {"Greek Funds"}),
				    FundText = Table.TransformColumns(ExpFunds, {{"Greek Funds", each if _ = null then "" else _, type text}}),
				    JoinPipe = Table.NestedJoin(FundText, {"Company ID"}, PipeT, {"pid"}, "P", JoinKind.LeftOuter),
				    ExpPipe = Table.ExpandTableColumn(JoinPipe, "P", {"Pipeline Stage", "Recommendation", "Next Action"}),
				    Typed = Table.TransformColumnTypes(ExpPipe, {{"Last Verified", type date}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
